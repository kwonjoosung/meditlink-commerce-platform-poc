### 5. 전체 조회 (ProductGroup + Product + Price)
### ============================================

### 5-1. ProductGroup 상세 조회 (하위 Product + Price 포함)
GET {{baseUrl}}/product-groups/{{productGroupId}}

> {%
    client.test("ProductGroup 전체 트리 조회", function() {
        client.assert(response.status === 200, "Status 200");
        client.assert(response.body.products.length === 2, "Product 2개");
    });
%}

###

### 5-2. Product 상세 조회 (Price 포함)
GET {{baseUrl}}/products/{{productId}}

> {%
    client.test("Product 상세 + Price 조회", function() {
        client.assert(response.status === 200, "Status 200");
        client.assert(response.body.prices.length === 1, "Price 1개 (1개 삭제됨)");
        client.assert(response.body.features.length === 2, "Feature 2개");
    });
%}


### ============================================
### 6. Coupon BC — 프로모션 정책 + 쿠폰 발행
### ============================================

### 6-1. 프로모션 정책 생성 (20% 할인)
POST {{baseUrl}}/coupons/policies
Content-Type: application/json

{
  "name": "신규 가입 20% 할인",
  "description": "신규 고객 대상 20% 할인 프로모션",
  "discountType": "PERCENTAGE",
  "discountValue": 20,
  "eligibility": {"segments": ["new_customer"]},
  "applicableProductIds": [],
  "maxRedemptions": 100,
  "validFrom": "2026-01-01T00:00:00Z",
  "validUntil": "2026-12-31T23:59:59Z"
}

> {%
    client.global.set("policyId", response.body.policyId);
    client.test("프로모션 정책 생성 성공", function() {
        client.assert(response.status === 201, "Status 201");
        client.assert(response.body.name === "신규 가입 20% 할인", "이름 일치");
        client.assert(response.body.stripeCouponId != null, "Stripe Coupon ID 할당됨");
    });
%}

###

### 6-2. 쿠폰 발행 (정책 기반)
POST {{baseUrl}}/coupons/issue
Content-Type: application/json

{
  "policyId": "{{policyId}}",
  "customerId": "cust_test_001"
}

> {%
    client.global.set("couponId", response.body.couponId);
    client.test("쿠폰 발행 성공", function() {
        client.assert(response.status === 201, "Status 201");
        client.assert(response.body.status === "ACTIVE", "Status ACTIVE");
        client.assert(response.body.customerId === "cust_test_001", "고객 ID 일치");
    });
%}

###

### 6-3. 쿠폰 사용
POST {{baseUrl}}/coupons/{{couponId}}/redeem

> {%
    client.test("쿠폰 사용 성공", function() {
        client.assert(response.status === 200, "Status 200");
        client.assert(response.body.status === "REDEEMED", "Status REDEEMED");
    });
%}

###

### 6-4. 고객별 쿠폰 조회
GET {{baseUrl}}/coupons/customer/cust_test_001

> {%
    client.test("고객별 쿠폰 조회 성공", function() {
        client.assert(response.status === 200, "Status 200");
        client.assert(response.body.length >= 1, "1개 이상");
    });
%}


